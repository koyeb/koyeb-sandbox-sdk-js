{
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/test-support.ts"],
  "compilerOptions": {
    "outDir": "lib",
    "module": "nodenext",
    "moduleResolution": "node16",
    "target": "es2024",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "strict": true
  }
}
